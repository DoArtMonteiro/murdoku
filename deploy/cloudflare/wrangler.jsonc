{
  // The Worker that serves Alibi. Always deploy it with this file passed explicitly:
  // `npm run deploy:cloudflare`.
  // This file is not at the repository root, so a tool that looks for a root config
  // cannot pick it up. That is all the location does. A bare `wrangler deploy` at the
  // root (what an old Workers Builds connection runs) finds no config, auto-detects the
  // Vite project and, from the package name, targets a Worker called `murdoku`; it never
  // reads this file or the guard script. Disconnecting the old connection is the only
  // real protection: see README.md in this folder.
  // Paths below are relative to this file. Build first (`npm run build`).
  "name": "alibi-game",
  "account_id": "e7051a1583673d9caec0521af5104117",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // The script only guards the asset directories (see worker.js). It serves no page itself.
  "main": "./worker.js",
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    // Unknown paths get index.html, so the app also opens from any URL.
    "not_found_handling": "single-page-application",
    // Only the paths whose files are cached as immutable (/assets/*, see public/_headers) and the
    // service-worker helper. A miss there must be a 404, not the app shell. Every request under these
    // patterns invokes the Worker (about 21 on a first visit); models and sprites are left out on
    // purpose, so a missing one gets the shell with a revalidating header, never an immutable one.
    "run_worker_first": ["/assets/*", "/workbox-*"]
  }
}

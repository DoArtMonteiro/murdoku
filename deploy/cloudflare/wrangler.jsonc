{
  // The Worker that serves Alibi. This file is deliberately not at the repository
  // root, so a tool that looks for a root Wrangler config (for example an old
  // Workers Builds connection) cannot pick it up and deploy over another Worker.
  // Always pass it explicitly: `npm run deploy:cloudflare`.
  // Paths below are relative to this file. Build first (`npm run build`).
  "name": "alibi-game",
  "account_id": "e7051a1583673d9caec0521af5104117",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  // The script only guards the asset directories (see worker.js). It serves no page itself.
  "main": "./worker.js",
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    // Unknown paths get index.html, so the app also opens from any URL.
    "not_found_handling": "single-page-application",
    // Paths that name a file, never a page. A miss here must be a 404, not the app shell.
    "run_worker_first": ["/assets/*", "/kenney3d/*", "/kenney/*", "/workbox-*"]
  }
}
